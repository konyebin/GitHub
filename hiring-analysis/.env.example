# Folder settings for the hiring analysis project (standalone; unrelated to any other project in this repo).
# Copy to .env (git-ignored) and edit. ${VAR} references and paths relative to hiring-analysis/ are supported.

# Base folder. Replace with the folder that holds your redacted data, for example your OneDrive CSAP folder.
HIRING_BASE=data/synthetic

# Parent folder. Create one folder per cohort inside it, named like "AMER FY27Q1", and put that cohort's screening and
# scores workbooks there. Keep one shared resumes/ folder of redacted .docx files in the parent (the redactor's single
# output folder keeps candidateN numbers unique across cohorts).
HIRING_DATA_DIR=${HIRING_BASE}

# Where processed CSVs, results and dashboards are written. Keep it somewhere private.
HIRING_OUT_DIR=${HIRING_BASE}/processed

# Month the fiscal year starts (1-12). Used to work out the year of AC day sheet names such as "AMER Oct 15".
HIRING_FISCAL_START_MONTH=8

# Smallest number of AC attendees for a cohort to get its own dashboard; smaller cohorts count only in "All cohorts".
HIRING_MIN_COHORT_AC=30

# Optional. URL of the Cloudflare Worker in ask-worker/ that answers questions with AI.
# Used only by the shareable dashboard. Leave empty to keep Ask the data as a plain search with no AI.
HIRING_ASK_ENDPOINT=
